<Project>
  <!-- Validate that the consumer's C# language version is compatible with Entity Framework 6.
       C# 14 "first-class span" feature changes overload resolution of .Contains() from
       Enumerable.Contains to MemoryExtensions.Contains(ReadOnlySpan), which EF6 LINQ provider
       cannot translate. This affects any LINQ-to-Entities query using .Contains() on arrays. -->
  <Target Name="RhetosEf6ValidateLangVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_Ef6LangVersionOk Condition="'$(LangVersion)' != '' And
        '$(LangVersion)' != 'default' And '$(LangVersion)' != 'latest' And
        '$(LangVersion)' != 'latestMajor' And '$(LangVersion)' != 'preview'">maybe</_Ef6LangVersionOk>
      <_Ef6LangVersionOk Condition="'$(_Ef6LangVersionOk)' == 'maybe' And
        $([System.Char]::IsDigit('$(LangVersion)', 0)) And
        $([MSBuild]::VersionLessThanOrEquals('$(LangVersion)', '13.0'))">true</_Ef6LangVersionOk>
    </PropertyGroup>
    <Error Condition="'$(_Ef6LangVersionOk)' != 'true'" Code="RHETOS001"
      Text="Rhetos.MsSqlEf6 requires C# language version 13 or lower (current LangVersion: '$(LangVersion)'). C# 14 'first-class span' feature changes .Contains() overload resolution from Enumerable.Contains to MemoryExtensions.Contains(ReadOnlySpan), which Entity Framework 6 LINQ provider cannot translate. Set &lt;LangVersion&gt;13&lt;/LangVersion&gt; in your project file or Directory.Build.props. See https://github.com/dotnet/ef6/issues/2322 for more information." />
  </Target>
</Project>
