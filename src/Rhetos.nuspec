<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>Rhetos</id>
    <version>6.1.1-dev</version>
    <authors>Omega software</authors>
    <owners>Omega software</owners>
    <license type="expression">AGPL-3.0-only</license>
    <projectUrl>https://github.com/rhetos/rhetos</projectUrl>
    <description>Rhetos DSL framework libraries.</description>
    <readme>docs\Readme.md</readme>
    <copyright>Copyright Omega software 2013</copyright>
    <tags>Rhetos</tags>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Rhetos.DslParser" version="[6.1.1-dev,6.2.0)" />
        <dependency id="Autofac" version="9.3.1" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.5" />
        <dependency id="Microsoft.Extensions.Hosting" version="10.0.5" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="10.0.5" />
        <dependency id="Microsoft.Extensions.Localization.Abstractions" version="10.0.5" />
        <dependency id="Microsoft.Extensions.Logging" version="10.0.5" />
        <dependency id="Microsoft.Extensions.Logging.Console" version="10.0.5" />
        <dependency id="Microsoft.Extensions.Logging.Debug" version="10.0.5" />
        <dependency id="Microsoft.Extensions.Logging.EventLog" version="10.0.5" />
        <dependency id="Microsoft.Extensions.Options" version="10.0.5" />
        <dependency id="Newtonsoft.Json" version="13.0.3" />
        <dependency id="NLog" version="6.0.3" />
        <dependency id="System.ComponentModel.Composition" version="10.0.5" /> <!-- Rhetos plugins use MEF. -->
        <dependency id="System.Configuration.ConfigurationManager" version="10.0.5" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\Readme.md" target="docs" />
    <file src="Rhetos.Core\bin\Debug\net10.0\Rhetos.Core.dll" target="lib\net10.0" />
    <file src="Rhetos.Core\bin\Debug\net10.0\Rhetos.Core.xml" target="lib\net10.0" />
  </files>
</package>
